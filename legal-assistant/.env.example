# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git. NEVER commit a real key.
#
# These names have NO "NEXT_PUBLIC_" prefix on purpose: that keeps them on the
# server. Anything starting with NEXT_PUBLIC_ would be shipped to the browser.

# Required. Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite if left empty.
# Check the current model names in Google AI Studio if you see a "model isn't available" error.
GEMINI_MODEL=
